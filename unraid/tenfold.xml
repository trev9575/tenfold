<?xml version="1.0"?>
<Container version="2">
  <Name>tenfold</Name>
  <!-- Replace YOUR_GITHUB_USERNAME with your GitHub username in lowercase -->
  <Repository>ghcr.io/YOUR_GITHUB_USERNAME/tenfold:latest</Repository>
  <Registry>https://github.com/YOUR_GITHUB_USERNAME/tenfold/pkgs/container/tenfold</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/YOUR_GITHUB_USERNAME/tenfold</Support>
  <Project>https://github.com/YOUR_GITHUB_USERNAME/tenfold</Project>
  <Overview>Tenfold: a small self-hosted EOS-style team tool. Accountability chart, Level 10 meetings, scorecard, rocks, to-dos, issues, headlines and V/TO.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8090]/</WebUI>
  <Icon>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/tenfold/main/static/favicon.svg</Icon>
  <Config Name="Web UI Port" Target="8090" Default="8090" Mode="tcp" Description="Port for the web interface" Type="Port" Display="always" Required="true" Mask="false">8090</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/tenfold" Mode="rw" Description="Where the database is stored" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/tenfold</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="Time zone" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="COOKIE_SECURE" Target="COOKIE_SECURE" Default="false" Mode="" Description="Set to true only when served over HTTPS (reverse proxy)" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
